# Cloud login. Use a long, unique password.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password

# The container listens publicly; Railway provides HTTPS.
HOST=0.0.0.0
PORT=3000
DATA_DIR=/data
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Cloud AI writing (choose one provider and add its key).
AI_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Keep this stable so the WhatsApp login persists.
WHATSAPP_CLIENT_ID=codex-cloud
